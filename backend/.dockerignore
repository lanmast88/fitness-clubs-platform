# Контекст сборки — каталог backend, поэтому .dockerignore должен лежать здесь:
# файл в корне репозитория Docker не читает.
.venv/
__pycache__/
*.py[cod]
.ruff_cache/

.env
.env.*

# Статику собирает сам образ; версия с хоста не должна её перекрывать.
staticfiles/
# Логи теперь идут в stdout, но у разработчиков мог остаться файл от старой версии.
debug.log

Dockerfile
.dockerignore
