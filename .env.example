# Скопируйте в .env: cp .env.example .env
# Значения ниже рабочие для локальной разработки, менять ничего не обязательно.

# Для продакшена сгенерируйте свой:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# Адреса фронтенда, которым разрешены запросы к API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_DB=fitness_clubs_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Для запуска без Docker. В docker compose значение переопределяется на `db`.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Порты, которые docker compose публикует на хосте.
# Поменяйте, если заняты другими проектами.
POSTGRES_PUBLISHED_PORT=5433
BACKEND_PUBLISHED_PORT=8000
FRONTEND_PUBLISHED_PORT=5173
