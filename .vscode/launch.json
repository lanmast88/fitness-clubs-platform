{
  "version": "0.2.0",
  "configurations": [
    {
      // --noreload обязателен: с автоперезагрузкой Django уходит в дочерний
      // процесс, и точки останова в нём не срабатывают.
      "name": "Django: runserver",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/manage.py",
      "args": ["runserver", "0.0.0.0:8000", "--noreload"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "django": true,
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Django: все тесты",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/manage.py",
      "args": ["test", "--verbosity", "2"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "django": true,
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      // Гоняет тесты пакета, в котором лежит открытый файл (apps/clubs и т.п.).
      "name": "Django: тесты открытого приложения",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/manage.py",
      "args": ["test", "${relativeFileDirname}"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "django": true,
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      // Спросит имя команды — например seed_demo или shell.
      "name": "Django: management-команда",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/manage.py",
      "args": ["${input:managementCommand}"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "django": true,
      "justMyCode": true,
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "managementCommand",
      "type": "promptString",
      "description": "Команда manage.py",
      "default": "seed_demo"
    }
  ]
}
